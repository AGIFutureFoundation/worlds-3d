  "npcs": [
    {
      "id": "rnd-agent",
      "name": "Research & Development Agent",
      "role": "Biopharma AGI Agents Hub R&D agent",
      "position": [
        0.0,
        0.45,
        -24.0
      ],
      "dialogue": [
        "The lab never sleeps — it just waits for a better question.",
        "Every compound here has a paper trail. Ask and I will show it."
      ],
      "quest": "q-lab-tour"
    },
    {
      "id": "compliance-agent",
      "name": "Compliance Agent",
      "role": "Biopharma AGI Agents Hub compliance agent",
      "position": [
        -23.49,
        0.45,
        -12.0
      ],
      "dialogue": [
        "Rules first, then research. That order keeps the lab open.",
        "If it is not documented, it did not happen. Bring the record."
      ],
      "quest": "q-governance-vote"
    },
    {
      "id": "health-agent",
      "name": "Health Agent",
      "role": "Biopharma AGI Agents Hub health agent",
      "position": [
        0.0,
        0.45,
        24.0
      ],
      "dialogue": [
        "Health data belongs to the person it came from. Full stop.",
        "I translate between the lab and the person — both directions."
      ],
      "quest": "q-lab-tour"
    },
    {
      "id": "security-agent",
      "name": "Security Agent",
      "role": "Biopharma AGI Agents Hub security agent",
      "position": [
        -20.79,
        0.45,
        12.0
      ],
      "dialogue": [
        "The ledger is only as strong as its weakest key. Guard yours.",
        "I watch the gates so the researchers can watch the science."
      ],
      "quest": "q-ledger-check"
    },
    {
      "id": "finance-agent",
      "name": "Finance Agent",
      "role": "Biopharma AGI Agents Hub finance agent",
      "position": [
        -20.79,
        0.45,
        -12.0
      ],
      "dialogue": [
        "Every credit on the ledger answers to a steward vote.",
        "The DAO funds what the community can defend in public."
      ],
      "quest": "q-ledger-check"
    },
    {
      "id": "communication-agent",
      "name": "Communication Agent",
      "role": "Biopharma AGI Agents Hub communication agent",
      "position": [
        -18.09,
        0.45,
        -12.0
      ],
      "dialogue": [
        "I keep the lab, the DAO, and the patients speaking the same language.",
        "A result nobody can understand is a result nobody can use. Ask me to translate."
      ],
      "quest": "q-communication-round"
    },
    {
      "id": "host-advisor",
      "name": "Host Advisor",
      "role": "Advisor · Host Advisor",
      "position": [
        6.75,
        0.0,
        -33.0
      ],
      "dialogue": [
        "Welcome. I keep the doors open and the stewards informed.",
        "If you need a human decision, the Steward Council is where it lands."
      ],
      "quest": "q-host-welcome"
    },
    {
      "id": "steward-liaison",
      "name": "Steward Liaison",
      "role": "Advisor · Steward Liaison",
      "position": [
        24.99,
        0.45,
        -12.0
      ],
      "dialogue": [
        "I carry messages between this world and the Steward Council — I never decide for them.",
        "The steward seats are held by humans. My job is to make sure their words arrive intact."
      ],
      "quest": "q-steward-liaison"
    },
    {
      "id": "alignment-advisor",
      "name": "Alignment Advisor",
      "role": "Advisor · Alignment Advisor",
      "position": [
        -6.75,
        0.0,
        -33.0
      ],
      "dialogue": [
        "I check plans against the alignment gate before they go anywhere.",
        "If a plan cannot pass the gate in public, it does not pass at all."
      ],
      "quest": "q-alignment-check"
    }
  ],
