        {
          "text": "Visit the Louisiana Developer Desk",
          "target": "Zone · Louisiana Developer Desk",
          "kind": "place"
        }
      ],
      "reward": "Scout's Brief"
    },
    {
      "id": "q-forecast-check",
      "title": "Forecast Check",
      "description": "Check a market forecast against the evidence layer.",
      "steps": [
