          "text": "Talk to the Forecast Agent",
          "target": "forecast-agent",
          "kind": "npc"
        },
        {
          "text": "Collect the forecast spark at Market Editions",
          "target": "spark-forecast",
          "kind": "collectible"
        },
        {
          "text": "Visit the Evidence Layer",
          "target": "Zone · Evidence Layer",
          "kind": "place"
        }
      ],
      "reward": "Forecast Check Badge"
    },
    {
      "id": "q-evidence-review",
      "title": "Evidence Review",
      "description": "Put a claim through review and file the result.",
      "steps": [
        {
          "text": "Talk to the Review Agent",
          "target": "review-agent",
          "kind": "npc"
        },
        {
          "text": "Collect the evidence relic",
          "target": "relic-evidence",
          "kind": "collectible"
        },
        {
          "text": "Visit the Underwriting Desk",
          "target": "Zone · Underwriting Desk",
          "kind": "place"
        }
