  "npcs": [
    {
      "id": "guide",
      "name": "Guide",
      "role": "Master Dashboard guide",
      "position": [
        0.0,
        0.45,
        -24.0
      ],
      "dialogue": [
        "Every good site starts with a question. What are you looking for?",
        "Check the dashboard, then the evidence. The order matters."
      ],
