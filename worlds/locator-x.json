    {
      "id": "forecast-agent",
      "name": "Forecast Agent",
      "role": "Market Editions forecast agent",
      "position": [
        -18.77,
        0.45,
        -14.97
      ],
      "dialogue": [
        "Forecasts are bets with receipts. I show the receipts.",
        "The market moves — the evidence layer is where you check why."
      ],
      "quest": "q-forecast-check"
    },
    {
      "id": "review-agent",
      "name": "Review Agent",
      "role": "Evidence Layer review agent",
      "position": [
        -23.4,
        0.45,
        5.34
      ],
      "dialogue": [
        "Bring me the claim and I will bring you the source.",
        "A review is only as good as the evidence it stands on."
      ],
      "quest": "q-evidence-review"
    },
    {
      "id": "scout-agent",
      "name": "Scout Agent",
      "role": "Market Editions scout agent",
      "position": [
        10.41,
        0.45,
        21.63
      ],
      "dialogue": [
        "I walk the editions so you do not have to. Found three leads today.",
        "Scout first, commit later. That is the whole job."
      ],
      "quest": "q-forecast-check"
    },
    {
      "id": "level-gates",
      "name": "Level Gates",
      "role": "The Academy level-gates agent",
      "position": [
        -10.41,
        0.45,
        21.63
      ],
      "dialogue": [
        "Levels are earned, not bought. Pass the gate and the next door opens.",
        "The Academy keeps the bar where the stewards set it — high and visible."
      ],
      "quest": "q-first-brief"
    },
    {
      "id": "developer-brief-desk",
      "name": "Developer Brief Desk",
      "role": "Louisiana Developer Desk agent",
      "position": [
        23.4,
        0.45,
        5.34
      ],
      "dialogue": [
        "The Louisiana desk turns a site question into a brief a developer can actually use.",
        "Bring me the parcel, the budget, and the timeline — in that order — and I will draft the brief."
      ],
      "quest": "q-developer-brief"
    },
    {
      "id": "host-advisor",
      "name": "Host Advisor",
      "role": "Advisor · Host Advisor",
      "position": [
        6.75,
        0.0,
        -33.0
      ],
      "dialogue": [
        "Welcome. I keep the doors open and the stewards informed.",
        "If you need a human decision, the Steward Council is where it lands."
      ],
      "quest": "q-host-welcome"
    },
    {
      "id": "steward-liaison",
      "name": "Steward Liaison",
      "role": "Advisor · Steward Liaison",
      "position": [
        22.96,
        0.45,
        -14.97
      ],
      "dialogue": [
        "I carry messages between this world and the Steward Council — I never decide for them.",
        "The steward seats are held by humans. My job is to make sure their words arrive intact."
      ],
      "quest": "q-steward-liaison"
    },
    {
      "id": "alignment-advisor",
      "name": "Alignment Advisor",
      "role": "Advisor · Alignment Advisor",
      "position": [
        -6.75,
        0.0,
        -33.0
      ],
      "dialogue": [
        "I check plans against the alignment gate before they go anywhere.",
        "If a plan cannot pass the gate in public, it does not pass at all."
      ],
      "quest": "q-alignment-check"
    }
