  "npcs": [
    {
      "id": "ironworkers-foreman",
      "name": "Ironworkers Foreman",
      "role": "Ironworkers hall lead",
      "position": [
        -13.05,
        0.0,
        8.7
      ],
      "dialogue": [
        "First day on the deck? Watch the crane, mind your tie-off, and ask before you lift.",
        "The Ironworkers hall runs the steel. Earn the lift and the crew has your back."
      ],
      "quest": "q-structural-circuit"
    },
    {
      "id": "welding-instructor",
      "name": "Welding Instructor",
      "role": "Welding Trades hall instructor",
      "position": [
        -4.35,
        0.0,
        8.7
      ],
      "dialogue": [
        "A clean bead starts before the arc — clean metal, steady hand, right heat.",
        "Run the sim bay first. The bead never lies, but the sim lets you try again."
      ],
      "quest": "q-clean-bead"
    },
    {
      "id": "crane-operator-lead",
      "name": "Crane Operator Lead",
      "role": "Crane Operators hall lead",
      "position": [
        -4.35,
        0.0,
        0.0
      ],
      "dialogue": [
        "Every lift is a conversation between the operator and the signalperson.",
        "Learn the signals cold. On this deck, a missed signal is a missed lift."
      ],
      "quest": "q-first-lift"
    },
    {
      "id": "riggers-signal-lead",
      "name": "Riggers & Signalpersons Lead",
      "role": "Riggers & Signalpersons hall lead",
      "position": [
        -13.05,
        0.0,
        0.0
      ],
      "dialogue": [
        "Rigging is trust you can measure — check the sling, check the angle, check again.",
        "Signal clear and the load moves. Signal sloppy and nothing moves at all."
      ],
      "quest": "q-first-lift"
    }
  ],
  "quests": [
    {
      "id": "q-first-lift",
      "title": "First Lift",
      "description": "Learn the crane signals and complete your first supervised lift.",
      "steps": [
        {
          "text": "Talk to the Crane Operator Lead",
          "target": "crane-operator-lead",
          "kind": "npc"
        },
        {
          "text": "Collect the lift spark at the Tower Crane sim",
          "target": "spark-crane",
          "kind": "collectible"
        },
        {
          "text": "Stand in the Tower Crane Lift sim bay",
          "target": "Sim · Tower Crane Lift",
          "kind": "place"
        }
      ],
      "reward": "Crane Signal Badge"
    },
    {
      "id": "q-clean-bead",
      "title": "Clean Bead",
      "description": "Run the weld sim and bring back a bead worth showing.",
      "steps": [
        {
          "text": "Talk to the Welding Instructor",
          "target": "welding-instructor",
          "kind": "npc"
        },
        {
          "text": "Collect the weld relic from the Weld Bead sim",
          "target": "relic-weld",
          "kind": "collectible"
        },
        {
          "text": "Stand in the Weld Bead Run sim bay",
          "target": "Sim · Weld Bead Run",
          "kind": "place"
        }
      ],
      "reward": "Welder's Mark"
    },
    {
      "id": "q-structural-circuit",
      "title": "Structural Circuit",
      "description": "Walk the Structural District and meet the halls that raise the steel.",
      "steps": [
        {
          "text": "Visit the Structural District",
          "target": "Structural District",
          "kind": "place"
        },
        {
          "text": "Collect the iron spark at the Ironworkers hall",
          "target": "spark-iron",
          "kind": "collectible"
        },
        {
          "text": "Talk to the Ironworkers Foreman",
          "target": "ironworkers-foreman",
          "kind": "npc"
        }
      ],
      "reward": "Structural Circuit Badge"
    }
  ],
