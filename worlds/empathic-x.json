  "npcs": [
    {
      "id": "self-reader-guide",
      "name": "Self-Reader Guide",
      "role": "Self-Reader Grove guide",
      "position": [
        0.0,
        0.45,
        -24.0
      ],
      "dialogue": [
        "Start with yourself. What are you actually feeling right now?",
        "No judgment here — just noticing, one breath at a time."
      ],
      "quest": "q-first-reading"
    },
    {
      "id": "other-reader-guide",
      "name": "Other-Reader Guide",
      "role": "Other-Reader Commons guide",
      "position": [
        -20.79,
        0.45,
        -12.0
      ],
      "dialogue": [
        "Listening is a skill, not a talent. Practice it like one.",
        "Repeat back what you heard before you answer. It changes everything."
      ],
      "quest": "q-first-reading"
    },
    {
      "id": "repair-guide",
      "name": "Repair Guide",
      "role": "Repairer's Hall guide",
      "position": [
        -20.79,
        0.45,
        12.0
      ],
      "dialogue": [
        "Repair starts with owning the impact, not debating the intent.",
        "A good apology names what happened and what changes next."
      ],
      "quest": "q-repair-circle"
    },
    {
      "id": "room-reader-guide",
      "name": "Room-Reader Guide",
      "role": "Room-Reader Plaza guide",
      "position": [
        0.0,
        0.45,
        24.0
      ],
      "dialogue": [
        "Read the room before you enter it. Who is quiet? Who is carrying the weight?",
        "A room tells you what it needs if you stop talking long enough."
      ],
      "quest": "q-room-read"
    },
    {
      "id": "practitioner-guide",
      "name": "Practitioner Guide",
      "role": "Practitioner Workshop guide",
      "position": [
        20.79,
        0.45,
        12.0
      ],
      "dialogue": [
        "Practice is the whole path. Ten minutes a day beats one big weekend.",
        "Bring a real moment from your week and we will work it together."
      ],
      "quest": "q-repair-circle"
    },
    {
      "id": "host-advisor",
      "name": "Host Advisor",
      "role": "Advisor · Host Advisor",
      "position": [
        6.75,
        0.0,
        -33.0
      ],
      "dialogue": [
        "Welcome. I keep the doors open and the stewards informed.",
        "If you need a human decision, the Steward Council is where it lands."
      ],
      "quest": "q-host-welcome"
    },
    {
      "id": "steward-liaison",
      "name": "Steward Liaison",
      "role": "Advisor · Steward Liaison",
      "position": [
        24.99,
        0.45,
        -12.0
      ],
      "dialogue": [
        "I carry messages between this world and the Steward Council — I never decide for them.",
        "The steward seats are held by humans. My job is to make sure their words arrive intact."
      ],
      "quest": "q-steward-liaison"
    },
    {
      "id": "alignment-advisor",
      "name": "Alignment Advisor",
      "role": "Advisor · Alignment Advisor",
      "position": [
        -6.75,
        0.0,
        -33.0
      ],
      "dialogue": [
        "I check plans against the alignment gate before they go anywhere.",
        "If a plan cannot pass the gate in public, it does not pass at all."
      ],
      "quest": "q-alignment-check"
    }
  ],
