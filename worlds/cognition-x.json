  "npcs": [
    {
      "id": "k12-teacher",
      "name": "K–12 Teacher",
      "role": "K–12 pack teacher",
      "position": [
        -40.0,
        0.0,
        40.0
      ],
      "dialogue": [
        "Every big skill starts small. Pick one thing, practice it, and come show me.",
        "The campus is a map of everything worth learning — you get to choose the route."
      ],
      "quest": "q-first-lesson"
    },
    {
      "id": "trade-instructor",
      "name": "Trade School Instructor",
      "role": "Trade School pack instructor",
      "position": [
        -20.0,
        0.0,
        40.0
      ],
      "dialogue": [
        "A trade is a promise you can keep with your hands. Start with the basics.",
        "Measure twice, cut once — and when the sim lets you retry, retry until it sticks."
      ],
      "quest": "q-trade-path"
    },
    {
      "id": "future-work-coach",
      "name": "Future-Work Coach",
      "role": "Future-Work pack coach",
      "position": [
        0.0,
        0.0,
        40.0
      ],
      "dialogue": [
        "The work of tomorrow rewards people who keep learning. What do you want to try next?",
        "Bring me one spark from each row and we will map your next step together."
      ],
      "quest": "q-trade-path"
    },
    {
      "id": "health-guide",
      "name": "Preventive Health Guide",
      "role": "Preventive Health & Everyday Care pack guide",
      "position": [
        40.0,
        0.0,
        20.0
      ],
      "dialogue": [
        "Small daily habits are the cheapest medicine there is. Start with one.",
        "Check in with yourself the way you would check in with a friend."
      ],
      "quest": "q-healthy-day"
    }
  ],
  "quests": [
    {
      "id": "q-first-lesson",
      "title": "First Lesson",
      "description": "Take your first lesson on the campus and bring back what you learned.",
      "steps": [
        {
          "text": "Talk to the K–12 Teacher",
          "target": "k12-teacher",
          "kind": "npc"
        },
        {
          "text": "Collect the lesson spark at the K–12 hall",
          "target": "spark-k12",
          "kind": "collectible"
        },
        {
          "text": "Visit the Trade School hall",
          "target": "Trade School",
          "kind": "place"
        }
      ],
      "reward": "Learner's Spark"
    },
    {
      "id": "q-trade-path",
      "title": "Trade Path",
      "description": "Walk the trade route from school to future work.",
      "steps": [
        {
          "text": "Talk to the Trade School Instructor",
          "target": "trade-instructor",
          "kind": "npc"
        },
        {
          "text": "Collect the tools relic at the Trade School hall",
          "target": "relic-tools",
          "kind": "collectible"
        },
        {
          "text": "Visit the Future-Work hall",
          "target": "Future-Work",
          "kind": "place"
        }
      ],
      "reward": "Trade Path Badge"
    },
