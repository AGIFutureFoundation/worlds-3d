  "npcs": [
    {
      "id": "medical-ai-avatar",
      "name": "Medical AI Avatar",
      "role": "Medical Kiosk avatar",
      "position": [
        0.0,
        0.45,
        -24.0
      ],
      "dialogue": [
        "Hello — I am a demo guide, not a doctor. I can show you around the kiosk.",
        "If you feel unwell, please see a real clinician. I will point you to one."
      ],
      "quest": "q-kiosk-checkin"
    },
    {
      "id": "imaging-ai",
      "name": "Imaging AI",
      "role": "4D Imaging Room imaging AI",
      "position": [
        -22.83,
        0.45,
        -7.41
      ],
      "dialogue": [
        "The imaging room turns scans into something you can walk around.",
        "Every image here is a teaching example — never a diagnosis."
      ],
      "quest": "q-imaging-tour"
    },
